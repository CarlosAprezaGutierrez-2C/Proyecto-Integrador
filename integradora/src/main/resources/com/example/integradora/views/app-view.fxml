<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.integradora.controllers.AppController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label fx:id="lbl_titulo" text="INVENTARIO DE PRODUCTOS">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Buscar:" />
                <TextField fx:id="txt_buscar" prefWidth="300.0" promptText="Buscar por nombre o código..." />
                <Pane HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <Label fx:id="lbl_error" textFill="#f40000">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Button fx:id="btn_nuevo" onAction="#onOpenAddForm" text="Nuevo Producto" />
                <Button fx:id="btn_recargar" onAction="#onReload" text="Recargar Info" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button fx:id="btn_editar" onAction="#onEditProduct" text="Editar Seleccionado" />
                <Button fx:id="btn_eliminar" onAction="#onDeleteProduct" text="Eliminar" />
            </children>
        </HBox>

        <TableView fx:id="tbl_productos" prefHeight="400.0" prefWidth="760.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="col_id" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="col_nombre" prefWidth="220.0" text="Nombre" />
                <TableColumn fx:id="col_precio" prefWidth="100.0" text="Precio ($)" />
                <TableColumn fx:id="col_stock" prefWidth="100.0" text="Stock" />
                <TableColumn fx:id="col_categoria" prefWidth="180.0" text="Categoría" />
            </columns>
        </TableView>
    </children>
</VBox>