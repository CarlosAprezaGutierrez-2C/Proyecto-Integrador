<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.integradora.controllers.FormController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label fx:id="lbl_titulo" text="DATOS DEL PRODUCTO">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="10.0" prefWidth="70.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="ID:" />
                <TextField fx:id="txt_id" promptText="Código único" GridPane.columnIndex="1" />

                <Label text="Nombre:" GridPane.rowIndex="1" />
                <TextField fx:id="txt_nombre" promptText="Mínimo 3 caracteres" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Precio:" GridPane.rowIndex="2" />
                <TextField fx:id="txt_precio" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Stock:" GridPane.rowIndex="3" />
                <TextField fx:id="txt_stock" promptText="Solo números" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Categoría:" GridPane.rowIndex="4" />
                <TextField fx:id="txt_categoria" promptText="Ej: Bebidas" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </children>
        </GridPane>

        <Label fx:id="lbl_error" textFill="RED" wrapText="true" />

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btn_cancelar" onAction="#onCancel" text="Cancelar" />
                <Button fx:id="btn_guardar" onAction="#onSave" text="Guardar Producto" />
            </children>
        </HBox>
    </children>
</VBox>