<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="12.0" prefWidth="320.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.integradora.controllers.FormController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>

        <Label text="Datos del Producto">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" prefWidth="80.0" />
                <ColumnConstraints hgrow="SOMETIMES"  prefWidth="200.0" />
            </columnConstraints>

            <Label text="Codigo:"   GridPane.rowIndex="0" />
            <TextField fx:id="txt_id"        promptText="Ej: PROD001"   GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Nombre:"   GridPane.rowIndex="1" />
            <TextField fx:id="txt_nombre"    promptText="Minimo 3 letras" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Precio:"   GridPane.rowIndex="2" />
            <TextField fx:id="txt_precio"    promptText="Ej: 15.50"     GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Stock:"    GridPane.rowIndex="3" />
            <TextField fx:id="txt_stock"     promptText="Ej: 100"       GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Categoria:" GridPane.rowIndex="4" />
            <TextField fx:id="txt_categoria" promptText="Ej: Bebidas"   GridPane.columnIndex="1" GridPane.rowIndex="4" />
        </GridPane>

        <Label fx:id="lbl_error" textFill="RED" wrapText="true" />

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btn_cancelar" onAction="#onCancel" text="Cancelar" />
                <Button fx:id="btn_guardar"  onAction="#onSave"   text="Guardar" />
            </children>
        </HBox>

    </children>
</VBox>